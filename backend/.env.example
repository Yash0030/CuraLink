# Personal Health Record Organizer - Backend Environment Configuration

# Database Configuration (Neon Postgres)
# Use the pooled URL (e.g. ep-xyz-pooler.region.neon.tech) for application pool
DATABASE_URL=postgresql://user:password@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Direct URL for LangGraph AsyncPostgresSaver (if omitted, backend automatically derives it by stripping '-pooler')
CHECKPOINT_DATABASE_URL=postgresql://user:password@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Checkpointer mode: 'postgres' (Neon Postgres) or 'memory' (for local testing/fallback)
CHECKPOINTER=postgres

# Groq LLM Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Browser Configuration: 'local' (local Chromium) or 'browserbase' (Browserbase Cloud)
BROWSER_MODE=local
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSERBASE_REGION=ap-southeast-1

# Portals Base URL (Local mock portal or deployed Next.js site)
PORTAL_BASE_URL=http://localhost:3000

# Agent Fetch Mode: 'agent' (LLM tool-calling loop) or 'deterministic' (fixed tool sequence)
FETCH_MODE=agent
MAX_AGENT_STEPS=15

# Human-in-the-loop CAPTCHA timeout (in seconds)
CAPTCHA_TIMEOUT_SECONDS=120

# CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
